# --- Script construction ---

# Script structure (legacy variant):
#   prefix: validate difficulty in [mindiff, maxdiff), leave D and D-mindiff on stack
#   variable: multiply (D-mindiff) by dropdiff, compute CSV lock = max_csv - product
#   suffix: PoW hash verification and CHECKSIG
#
# Witness stack: sig, pubkey, prefix(3B), suffix(11B), h_b(variable), h_a(1B),
#                difficulty(1B), script, control_block(33B)

def _push_int(n):
    """Encode n as a minimal Script data push."""
    if n == 0:
        return bytes([0x00])
    neg = n < 0
    n = abs(n)
    data = []
    while n > 0:
        data.append(n & 0xff)
        n >>= 8
    if data[-1] & 0x80:
        data.append(0x80 if neg else 0x00)
    elif neg:
        data[-1] |= 0x80
    return bytes([len(data)] + data)

def _stack_multiply_ops(k):
    """Opcodes to multiply top-of-stack by integer k (consuming it)."""
    if k == 1:
        return bytes()
    bits = bin(k)[2:]
    ops = []
    for i in range(1, len(bits)):
        if bits[i] == '1':
            ops.append(0x76)  # DUP (save for later add)
        ops.append(0x76)  # DUP
        ops.append(0x93)  # ADD (double)
    ops.extend([0x93] * bits[1:].count('1'))
    return bytes(ops)

# 16 SUB DUP 0 GREATERTHANOREQUAL VERIFY DUP 64 LESSTHAN VERIFY
_SCRIPT_PREFIX = bytes.fromhex('60947600a2697601409f69')

# SWAP SUB CSV DROP, then PoW hash construction from h_b/h_a witness items
_SCRIPT_POWCHECK = bytes.fromhex(
    '7c94b275'  # SWAP SUB CSV DROP
    '0200006b'  # push 0, TOALTSTACK
    '760120a2636c04000000007e6b012094687660a2636c0200007e6b6094687658a2636c01007e6b5894'
    '687c825188766b517e020001947c7600876302000167765187630280006776528763014067765387'
    '630120677654876360677655876358677656876354675268686868686868779f696c6c7e7e6b'
)

# Legacy: assemble 0x03||prefix(3)||sig(64)||0x0b||suffix(11), HASH256 check, CHECKSIG
_ASSEMBLY_LEGACY = bytes.fromhex(
    '70'  # 2OVER (copy sig, pubkey from below prefix, suffix)
    '8201208875820140887c827c7e7e7c827c7e7c7eaa6c88ac'
)

# Stratum_a: Stratum-compatible variant. prevhash = sha256(prevpre) varies per
# work-height; pubkey stays constant. merkle_root = hash256(cbhash || hash256(sig)).
# witness order: prefix, prevpre, suffix, cbhash, sig, pubkey
# assemble prefix(4)||sha256(prevpre)(32)||merkle_root(32)||suffix(12), HASH256 check
_ASSEMBLY_STRATUM_A = bytes.fromhex(
    '82012088'                # SIZE 32 EQUALVERIFY (pubkey)
    '7882014088 7c'           # OVER SIZE 64 EQUALVERIFY SWAP (sig)
    'ad'                      # CHECKSIGVERIFY
    'aa7eaa'                  # HASH256 CAT HASH256 (merkle_root)
    '7c825c887e'              # SWAP SIZE OP_12 EQUALVERIFY CAT (suffix)
    '7ca87c7e7e'              # SWAP SHA256 SWAP CAT CAT (prevpre→prevhash)
    '82015088'                # SIZE 80 EQUALVERIFY
    'aa6c87'                  # HASH256 FROMALTSTACK EQUAL
)

SCRIPT_VARIANTS = {'legacy': _ASSEMBLY_LEGACY, 'stratum_a': _ASSEMBLY_STRATUM_A}

def build_script(dropdiff, mindiff, maxdiff, variant='legacy'):
    """Build a powcoins faucet script with given parameters."""
    max_csv = (maxdiff - mindiff) * dropdiff
    var = bytes([0x76]) + _stack_multiply_ops(dropdiff) + _push_int(max_csv)
    assembly = SCRIPT_VARIANTS[variant]
    return _SCRIPT_PREFIX + var + _SCRIPT_POWCHECK + assembly

def witness_weight(script, d, variant='legacy', cbhash_len=0, prevpre_len=0):
    """Witness weight for a claim at given d (approximate).

    The h_b field varies with d so this isn't constant.
    For fee estimation, use d=mindiff (worst case / max weight).
    """
    h_b_len = 32 - d // 8 - 1
    cs_script = 1 if len(script) < 253 else 3
    if variant == 'stratum_a':
        return (1              # witness item count
              + 1 + 64         # signature
              + 1 + 32         # pubkey
              + 1 + cbhash_len # cbhash (0 for CPU, 32 for Stratum)
              + 1 + prevpre_len # prevpre (0 for CPU, varies for Stratum)
              + 1 + 4          # prefix (version)
              + 1 + 12         # suffix (time+nbits+nonce)
              + 1 + h_b_len    # h_b
              + 1 + 1          # h_a
              + 1 + 1          # difficulty
              + cs_script + len(script)
              + 1 + 33)        # control_block
    return (1              # witness item count
          + 1 + 64         # signature
          + 1 + 32         # pubkey
          + 1 + 3          # prefix
          + 1 + 11         # suffix
          + 1 + h_b_len    # h_b
          + 1 + 1          # h_a
          + 1 + 1          # difficulty
          + cs_script + len(script)
          + 1 + 33)        # control_block

SCRIPTS = [
    (10, 16, 80, 'legacy', LEGACY_IPK),
    (4, 16, 80, 'legacy', LEGACY_IPK),
    (1, 16, 80, 'legacy', LEGACY_IPK),
    (10, 16, 80, 'stratum_a', LEGACY_IPK),
    (4, 16, 80, 'stratum_a', LEGACY_IPK),
    (1, 16, 80, 'stratum_a', LEGACY_IPK),
    (10, 16, 80, 'stratum_a', NUMS_IPK),
    (4, 16, 80, 'stratum_a', NUMS_IPK),
    (1, 16, 80, 'stratum_a', NUMS_IPK),
]

def get_tapinfo(args):
    tapinfo = {}
    for dropdiff, mindiff, maxdiff, variant, ipk in SCRIPTS:
        script = build_script(dropdiff, mindiff, maxdiff, variant)
        ti = taproot_construct(ipk, [("only-path", script)])
        spk = ti.scriptPubKey.hex()
        faucet_addr = json.loads(args.bcli("decodescript", spk)).get("address", None)
        if faucet_addr is None:
            logging.warning(f"Faucet address for delay {dropdiff} is unknown (spk={spk}), skipping")
            continue
        logging.debug(f"Faucet address {faucet_addr} (delay={dropdiff})")

        if spk in tapinfo:
            logging.warning(f"Duplicate faucet address for delays {tapinfo[spk][0]} and {dropdiff}, skipping")
            continue
        tapinfo[spk] = (dropdiff, mindiff, maxdiff, variant, script, ti, ipk, faucet_addr)
    return tapinfo

def _fmt_diff(n):
    d = 2**(n - 32)
    for suffix, threshold in [("T", 1e12), ("G", 1e9), ("M", 1e6), ("k", 1e3)]:
        if d >= threshold:
            return f"{d/threshold:.1f}{suffix}"
    if d >= 0.01:
        return f"{d:.2f}"
    return f"{d:f}".rstrip('0')

